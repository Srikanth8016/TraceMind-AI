# ---------------------------------------------------------------------------
# TraceMind AI — environment variable template
#
# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example IS committed as documentation.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (psycopg 3 driver).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://tracemind:tracemind@localhost:5432/tracemind

# Test database (isolated from production data).
# Used automatically by pytest via conftest.py.
TEST_DATABASE_URL=postgresql+psycopg://tracemind:tracemind@localhost:5432/tracemind_test

# API Key for authenticating client requests to protected endpoints (Milestone 5).
# Replace with a strong, cryptographically secure random value in your local .env.
# Never commit real keys or secrets to version control.
TRACEMIND_API_KEY=replace-with-your-secure-random-api-key

# Celery & Redis configuration (Milestone 6).
# Broker transports task messages; result backend stores task state.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Execute tasks synchronously in-process (ideal for tests and local development without Redis)
CELERY_TASK_ALWAYS_EAGER=False

# Incident correlation time window in seconds (Milestone 7, default: 3600 / 1 hour)
# Error events with the same fingerprint occurring within this window group into the same incident.
INCIDENT_CORRELATION_WINDOW_SECONDS=3600

# AI Incident Investigation Engine (Milestone 8)
# Provider options:
#   - 'mock'  : Zero-cost deterministic stub for local testing without external API calls (default)
#   - 'groq'  : Free, high-speed LLM inference via Groq (recommended: llama-3.3-70b-versatile)
#   - 'openai': OpenAI API (requires paid credit)
LLM_PROVIDER=groq

# Groq API Key (get free at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: LLM_API_KEY can also be used interchangeably for any OpenAI-compatible provider
# LLM_API_KEY=

# Base URL (default for groq is https://api.groq.com/openai/v1)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Recommended Groq Models:
#   - llama-3.3-70b-versatile (top reasoning, structured JSON outputs, deep root-cause diagnosis)
#   - llama-3.1-8b-instant    (ultra-fast, lightweight)
LLM_MODEL=llama-3.3-70b-versatile

# Runbook Ingestion, Vector Retrieval & RAG (Milestone 9)
# Provider options:
#   - 'mock': Deterministic, offline 384-d pseudo-semantic embeddings (default for tests and local dev)
#   - 'http' / 'openai': External OpenAI-compatible /embeddings endpoint
EMBEDDING_PROVIDER=mock

# Optional API key for remote embedding provider
EMBEDDING_API_KEY=

# Base URL for OpenAI-compatible embedding endpoint
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Embedding model identifier and dimensionality
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Production Readiness & Observability (Milestone 10)
# Target environment: 'development', 'testing', 'staging', or 'production'
ENVIRONMENT=development

# Logging configuration ('json' for production container logs, 'text' for local console)
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Zero-Budget Demo Deployment (Render / Neon free tier)
# In DEMO_MODE=True, background tasks execute in-process via FastAPI BackgroundTasks,
# eliminating the need for a continuously running separate Celery worker or paid Redis instance.
DEMO_MODE=False

# Allowed CORS Origins (comma-separated, e.g. https://my-frontend.vercel.app,http://localhost:3000)
CORS_ORIGINS=*




